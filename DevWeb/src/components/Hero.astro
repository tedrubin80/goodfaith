---
const github = 'https://github.com/tedrubin80/goodfaith';
---

<section class="hero" id="top">
  <div class="hero__atmosphere" aria-hidden="true"></div>
  <div class="container hero__inner">
    <p class="hero__brand reveal" data-reveal>Good Faith</p>
    <h1 class="hero__headline reveal" data-reveal>
      Open-source label management for teams who outgrew the spreadsheet.
    </h1>
    <p class="hero__lead reveal" data-reveal>
      Multi-distributor royalties, splits, rights, and role-based portals —
      self-hosted under the MIT license. Never a cut of your earnings.
    </p>
    <div class="hero__actions reveal" data-reveal>
      <a href={github} class="button button--primary button--lg">View on GitHub</a>
      <a href="#install" class="button button--ghost button--lg">Install locally</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(92svh, 52rem);
    display: flex;
    align-items: flex-end;
    padding-block: var(--space-3xl) var(--space-2xl);
    overflow: hidden;
  }

  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(90% 70% at 12% 0%, oklch(0.72 0.08 195 / 0.22), transparent 55%),
      radial-gradient(70% 60% at 88% 18%, oklch(0.78 0.1 75 / 0.16), transparent 50%),
      linear-gradient(165deg, var(--color-bg), var(--color-surface));
  }

  .hero__atmosphere::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 65%, transparent);
    opacity: 0.35;
  }

  .hero__inner {
    max-width: 46rem;
    padding-bottom: var(--space-lg);
  }

  .hero__brand {
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(3rem, 10vw, 5.75rem);
    font-weight: 550;
    letter-spacing: -0.04em;
    line-height: 0.92;
    margin: 0;
  }

  .hero__headline {
    margin-top: var(--space-md);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 450;
    color: var(--color-muted);
    max-width: 28ch;
  }

  .hero__lead {
    margin-top: var(--space-md);
    font-size: var(--text-lead);
    color: var(--color-muted);
    max-width: 42ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
</style>
