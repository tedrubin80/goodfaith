---
const layers = [
  { layer: 'Portal', tech: 'Next.js 16 · TypeScript' },
  { layer: 'API', tech: 'Django 6 · Django REST Framework' },
  { layer: 'Data', tech: 'PostgreSQL 16' },
  { layer: 'Jobs', tech: 'Celery · Redis' },
  { layer: 'Deploy', tech: 'Docker Compose · Railway · Vercel' },
  { layer: 'License', tech: 'MIT' },
];
---

<section class="section stack" id="stack">
  <div class="container stack__inner">
    <div class="stack__copy reveal" data-reveal>
      <h2>Built for operators who read the stack</h2>
      <p>
        Python where statement normalization matters. A typed portal for
        day-to-day label work. Compose locally; Railway + Vercel when you
        want cloud.
      </p>
    </div>
    <dl class="stack__list reveal" data-reveal>
      {
        layers.map((row) => (
          <div class="stack__row">
            <dt>{row.layer}</dt>
            <dd>{row.tech}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stack {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .stack__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: start;
  }

  .stack__copy h2 {
    font-size: var(--text-h2);
  }

  .stack__copy p {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    max-width: 36ch;
  }

  .stack__list {
    margin: 0;
  }

  .stack__row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .stack__row dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stack__row dd {
    margin: 0;
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .stack__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
