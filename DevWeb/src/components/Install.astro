---
const github = 'https://github.com/tedrubin80/goodfaith';
const steps = [
  { n: '01', title: 'Clone & compose', body: 'docker compose up --build' },
  { n: '02', title: 'Seed a label', body: 'python manage.py seed_label --demo' },
  { n: '03', title: 'Open the portal', body: 'http://localhost:3020' },
];
---

<section class="section install" id="install">
  <div class="container">
    <div class="install__intro reveal" data-reveal>
      <h2>First-run in three steps</h2>
      <p>The portal root is an install welcome page with live API health — not a SaaS funnel.</p>
    </div>
    <ol class="install__steps">
      {
        steps.map((s) => (
          <li class="reveal" data-reveal>
            <span class="install__n">{s.n}</span>
            <div>
              <h3>{s.title}</h3>
              <code>{s.body}</code>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="install__actions reveal" data-reveal>
      <a href={github} class="button button--primary button--lg">Clone on GitHub</a>
      <a href={`${github}/blob/main/docs/install/README.md`} class="button button--ghost button--lg">
        Deploy docs
      </a>
    </div>
  </div>
</section>

<style>
  .install {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .install__intro h2 {
    font-size: var(--text-h2);
  }

  .install__intro p {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    max-width: 40ch;
  }

  .install__steps {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .install__steps li {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .install__n {
    font-family: Fraunces, Georgia, serif;
    font-size: 1.5rem;
    color: var(--color-accent-text);
    line-height: 1;
  }

  .install__steps h3 {
    font-size: var(--text-h3);
  }

  .install__steps code {
    display: block;
    margin-top: 0.35rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .install__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }
</style>
