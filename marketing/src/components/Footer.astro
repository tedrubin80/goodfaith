---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__wordmark">Good Faith Record Management</p>
      <p class="site-footer__tagline">
        Flat-fee, distributor-agnostic label management. No percentage of
        earnings, ever.
      </p>
    </div>

    <div class="site-footer__meta">
      <a href="mailto:hello@usegoodfaith.com">hello@usegoodfaith.com</a>
      <p>&copy; {year} Good Faith Record Management.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-2xl);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .site-footer__wordmark {
    font-weight: 700;
  }

  .site-footer__tagline {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--text-sm);
    max-width: 32ch;
  }

  .site-footer__meta {
    text-align: right;
    font-size: var(--text-sm);
  }

  .site-footer__meta a {
    text-decoration: none;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .site-footer__meta p {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 30rem) {
    .site-footer__meta {
      text-align: left;
    }
  }
</style>
