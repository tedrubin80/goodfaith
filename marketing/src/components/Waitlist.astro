---
---

<section class="waitlist section" id="waitlist">
  <div class="container waitlist__inner reveal" data-reveal>
    <div class="waitlist__copy">
      <h2 class="waitlist__heading">Be first in when we open the doors.</h2>
      <p class="waitlist__lead">
        We're onboarding a small first group of indie labels before general
        availability. Leave your email and we'll reach out when there's a
        seat for you.
      </p>
    </div>

    <form class="waitlist__form" id="waitlist-form" novalidate>
      <div class="waitlist__field">
        <label for="waitlist-email" class="visually-hidden">Email address</label>
        <input
          type="email"
          id="waitlist-email"
          name="email"
          placeholder="you@yourlabel.com"
          autocomplete="email"
          required
        />
        <button type="submit" class="button button--primary">
          Join the waitlist
        </button>
      </div>
      <p class="waitlist__hint" id="waitlist-hint">
        No spam. One email when we're ready for you.
      </p>
      <p class="waitlist__error" id="waitlist-error" role="alert" hidden>
        That doesn't look like a valid email — mind double-checking it?
      </p>
    </form>

    <div class="waitlist__success" id="waitlist-success" hidden role="status">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9.5" />
        <path d="M8 12.5l2.5 2.5L16 9" />
      </svg>
      <p>You're on the list. We'll email you at <strong id="waitlist-success-email"></strong> when it's your turn.</p>
    </div>
  </div>
</section>

<style>
  .waitlist__inner {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .waitlist__heading {
    font-size: var(--text-h2);
  }

  .waitlist__lead {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-lead);
  }

  .waitlist__form {
    margin-top: var(--space-xl);
  }

  .waitlist__field {
    display: flex;
    gap: var(--space-2xs);
    max-width: 28rem;
    margin-inline: auto;
  }

  .waitlist__field input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--text-body);
    min-height: 44px;
    transition: border-color var(--duration-fast) var(--ease-out-quart);
  }

  .waitlist__field input:focus-visible {
    border-color: var(--color-primary-fill);
  }

  .waitlist__field input:user-invalid {
    border-color: var(--color-error);
  }

  .waitlist__hint {
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .waitlist__error {
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-error);
    font-weight: 600;
  }

  .waitlist__success {
    margin-top: var(--space-xl);
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  /* [hidden] must win by default; only declare display once it's shown */
  .waitlist__success:not([hidden]) {
    display: flex;
    animation: success-in var(--duration-slow) var(--ease-out-quart);
  }

  .waitlist__success svg {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--color-accent-text);
  }

  .waitlist__success p {
    color: var(--color-muted);
    max-width: 36ch;
  }

  @keyframes success-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .waitlist__success {
      animation: none;
    }
  }

  @media (max-width: 30rem) {
    .waitlist__field {
      flex-direction: column;
    }
  }
</style>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const input = document.getElementById('waitlist-email') as HTMLInputElement | null;
  const errorEl = document.getElementById('waitlist-error');
  const successEl = document.getElementById('waitlist-success');
  const successEmail = document.getElementById('waitlist-success-email');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!input) return;

    const valid = input.checkValidity();
    errorEl?.toggleAttribute('hidden', valid);

    if (!valid) {
      input.focus();
      return;
    }

    // NOTE: no email-capture backend is wired up yet. This is a
    // client-side-only success state; connect this to a real service
    // (e.g. a hosted form endpoint or a small serverless function)
    // before this page collects real signups.
    if (successEmail) successEmail.textContent = input.value;
    form.hidden = true;
    successEl?.removeAttribute('hidden');
  });
</script>
