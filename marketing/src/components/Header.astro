---
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="#top" class="wordmark">
      Good Faith<span class="wordmark__sub">Record Management</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <a href="#how-it-works">How it works</a>
      <a href="#pricing">Pricing</a>
      <a href="#trust">Trust</a>
    </nav>

    <div class="site-header__actions">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch to dark theme"
        aria-pressed="false"
      >
        <svg class="icon icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.25" />
          <path d="M12 2.5v2.25M12 19.25v2.25M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.5 12h2.25M19.25 12h2.25M4.4 19.6l1.6-1.6M18 6l1.6-1.6" />
        </svg>
        <svg class="icon icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.6 6.6 0 0 0 10.5 10.5Z" />
        </svg>
      </button>
      <a href="mailto:hello@usegoodfaith.com" class="button button--primary button--sm">Get in touch</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: color-mix(in oklch, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px) saturate(1.1);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-sm) clamp(1.25rem, 4vw, 2.5rem);
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-ink);
    margin-right: auto;
    white-space: nowrap;
  }

  .wordmark__sub {
    font-weight: 500;
    font-size: 0.6875rem;
    color: var(--color-muted);
    letter-spacing: 0.01em;
  }

  .site-nav {
    display: flex;
    gap: var(--space-lg);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .site-nav a:hover {
    color: var(--color-ink);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    position: relative;
    transition: border-color var(--duration-fast) var(--ease-out-quart);
  }

  .theme-toggle:hover {
    border-color: var(--color-muted);
  }

  .icon {
    width: 1.125rem;
    height: 1.125rem;
    grid-area: 1 / 1;
    transition: opacity var(--duration-base) var(--ease-out-quart), transform var(--duration-base) var(--ease-out-quart);
  }

  .icon--moon {
    opacity: 0;
    transform: scale(0.6) rotate(-30deg);
  }

  :global([data-theme='dark']) .icon--sun {
    opacity: 0;
    transform: scale(0.6) rotate(30deg);
  }

  :global([data-theme='dark']) .icon--moon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon--sun {
      opacity: 0;
      transform: scale(0.6) rotate(30deg);
    }
    :global(:root:not([data-theme='light'])) .icon--moon {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @media (max-width: 43.75rem) {
    .site-nav {
      display: none;
    }
    .wordmark__sub {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function currentTheme(): 'light' | 'dark' {
    const attr = root.getAttribute('data-theme');
    if (attr === 'light' || attr === 'dark') return attr;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyLabel() {
    const theme = currentTheme();
    toggle?.setAttribute('aria-pressed', String(theme === 'dark'));
    toggle?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  }

  toggle?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('gfrm-theme', next);
    } catch (e) {}
    applyLabel();
  });

  applyLabel();
</script>
