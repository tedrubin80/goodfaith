---
const tiers = [
  {
    name: 'Starter',
    price: '$49',
    yearly: '$499/yr',
    blurb: 'For labels just outgrowing the spreadsheet.',
    features: [
      'Up to 10 artists',
      'Unlimited releases',
      'Core royalty accounting',
      'Artist portals',
    ],
    featured: false,
  },
  {
    name: 'Growth',
    price: '$149',
    yearly: '$1,499/yr',
    blurb: 'For labels with real contracts and a growing roster.',
    features: [
      'Up to 50 artists',
      'Everything in Starter',
      'Publishing administration',
      'Contract management',
      'Analytics & reporting',
    ],
    featured: true,
  },
  {
    name: 'Pro',
    price: '$349',
    yearly: '$3,499/yr',
    blurb: 'For labels ready to build on the platform.',
    features: [
      'Unlimited artists',
      'Everything in Growth',
      'API access',
      'White-label portals',
      'Priority support',
    ],
    featured: false,
  },
];

const commitments = [
  'Never a percentage of your royalties',
  'Full data export included on every plan',
  'Cancel any time — data stays accessible for 90 days',
  'Price lock guarantee for annual subscribers',
];
---

<section class="pricing section" id="pricing">
  <div class="container">
    <div class="pricing__intro reveal" data-reveal>
      <h2 class="pricing__heading">One flat fee. No surprises.</h2>
      <p class="pricing__lead">
        Pick a tier by roster size. The price never moves because your
        catalog started earning more.
      </p>
    </div>

    <div class="pricing__grid reveal" data-reveal>
      {tiers.map((tier) => (
        <div class:list={['tier', { 'tier--featured': tier.featured }]}>
          {tier.featured && <p class="tier__badge">Most labels start here</p>}
          <h3 class="tier__name">{tier.name}</h3>
          <p class="tier__blurb">{tier.blurb}</p>
          <p class="tier__price">
            <span class="tier__price-amount">{tier.price}</span>
            <span class="tier__price-period">/mo</span>
          </p>
          <p class="tier__price-yearly">or {tier.yearly}</p>
          <ul class="tier__features">
            {tier.features.map((f) => (
              <li>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 10.5l3.5 3.5L16 6" />
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a
            href={`mailto:hello@usegoodfaith.com?subject=${encodeURIComponent(`${tier.name} plan inquiry`)}`}
            class:list={['button', 'button--block', tier.featured ? 'button--primary' : 'button--secondary']}
          >
            Get in touch
          </a>
        </div>
      ))}
    </div>

    <ul class="pricing__commitments reveal" data-reveal>
      {commitments.map((c) => (
        <li>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 10.5l3.5 3.5L16 6" />
          </svg>
          <span>{c}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pricing__intro {
    max-width: 40ch;
    margin-bottom: var(--space-2xl);
  }

  .pricing__heading {
    font-size: var(--text-h2);
  }

  .pricing__lead {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-lead);
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-lg);
  }

  .tier {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }

  .tier--featured {
    background: var(--color-bg);
    border: 1.5px solid var(--color-primary-fill);
    box-shadow: var(--shadow-md);
  }

  .tier__badge {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary-text);
  }

  .tier__name {
    font-size: var(--text-h3);
  }

  .tier__blurb {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--text-sm);
    min-height: 2.5em;
  }

  .tier__price {
    margin-top: var(--space-md);
    display: flex;
    align-items: baseline;
    gap: var(--space-3xs);
  }

  .tier__price-amount {
    font-size: var(--text-h2);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-display);
  }

  .tier__price-period {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .tier__price-yearly {
    margin-top: var(--space-3xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .tier__features {
    list-style: none;
    margin: var(--space-lg) 0 var(--space-lg);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex-grow: 1;
  }

  .tier__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
  }

  .tier__features svg {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-accent-text);
    margin-top: 0.125rem;
  }

  .pricing__commitments {
    list-style: none;
    margin: var(--space-2xl) 0 0;
    padding: var(--space-lg);
    background: var(--color-surface-2);
    border-radius: var(--radius-lg);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-sm) var(--space-lg);
  }

  .pricing__commitments li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .pricing__commitments svg {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-accent-text);
    margin-top: 0.125rem;
  }
</style>
