# Production / Railway environment template (copy to backend/.env or set in dashboard)
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False

# Injected by Railway Postgres / Redis plugins when linked:
# DATABASE_URL=
# CELERY_BROKER_URL=  (or REDIS_URL — map in Railway variables)
# CELERY_RESULT_BACKEND=

DJANGO_ALLOWED_HOSTS=.up.railway.app,your-api.example.com
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# Required for multi-worker 2FA pending-login tokens (fail-closed in prod settings).
DJANGO_CACHE_URL=redis://default:PASSWORD@HOST:PORT/1

# SSL defaults to True in prod settings; override only behind a TLS-terminating proxy if needed.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Optional object storage for statement / DAM uploads
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
